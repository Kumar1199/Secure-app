{
  "name": "secure-exam-proctor",
  "version": "1.0.0",
  "description": "Secure Proctored Exam Application",
  "author": "SecureExam Team",
  "main": "src/main/main.js",
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.22-rc.20250304",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.6.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^26.6.10",
    "electron-builder": "^24.13.3"
  },
  "scripts": {
    "prepare:proctor": "node scripts/prepareProctorAssets.cjs",
    "prebuild": "node scripts/prepareProctorAssets.cjs",
    "test:proctor": "node --test tests/proctorPolicy.test.cjs tests/proctorSubmission.test.cjs tests/proctorEvidence.test.cjs",
    "build": "electron-builder --win --x64",
    "start": "electron ."
  },
  "build": {
    "appId": "com.secureexam.proctor",
    "productName": "SecureExam",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "sign": "./customSign.js",
      "signExts": [
        "!exe"
      ],
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
